# Usage: cmake -DIN=<file>[|<file>...] -DOUT=<file.cpp> -DNAME=<symbol> -P embed_text.cmake
# Writes a C++ file that holds the text files (shader source), concatenated, as a null-terminated char array.
string(REPLACE "|" ";" parts "${IN}")
set(text "")
foreach(part IN LISTS parts)
  file(READ "${part}" piece)
  string(APPEND text "${piece}")
endforeach()
set(delim "jpo_src")
string(FIND "${text}" ")${delim}\"" clash)
if(NOT clash EQUAL -1)
  message(FATAL_ERROR "${IN} contains the raw string delimiter")
endif()
file(WRITE "${OUT}" "// Generated by cmake/embed_text.cmake from ${IN}. Do not edit.\nextern const char ${NAME}[];\nconst char ${NAME}[] = R\"${delim}(${text})${delim}\";\n")
