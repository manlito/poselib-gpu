{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "wasm-cpu",
      "runtimeExecutable": "python3",
      "runtimeArgs": ["-m", "http.server", "8765", "--directory", "build/wasm-cpu/web"],
      "port": 8765
    },
    {
      "name": "wasm",
      "runtimeExecutable": "python3",
      "runtimeArgs": ["-m", "http.server", "8766", "--directory", "build/wasm/web"],
      "port": 8766
    },
    {
      "name": "wasm-site",
      "runtimeExecutable": "python3",
      "runtimeArgs": ["-m", "http.server", "8767", "--bind", "127.0.0.1", "--directory", "build/wasm-site/web"],
      "port": 8767
    },
    {
      "name": "docs-site",
      "runtimeExecutable": "python3",
      "runtimeArgs": ["-m", "http.server", "8768", "--bind", "127.0.0.1", "--directory", "docs/_build/html"],
      "port": 8768
    }
  ]
}
